# sample.sub

universe = container
container_image = docker://bucky/medimage-flex-bucky-model:v1

executable = ./execute-testbench.sh

# Example of a private token
environment = "HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXX"

log = buckymodel_$(Cluster)_$(Process).log
error = buckymodel_$(Cluster)_$(Process).err
output = buckymodel_$(Cluster)_$(Process).out

# File transfers
should_transfer_files = YES
transfer_input_files = ./testbench, ./model_configs/buckymodel/config.json, osdf:///chtc/staging/b/bucky/datasets.zip
transfer_output_files = embeddings, results
when_to_transfer_output = ON_EXIT_OR_EVICT

# Request hardware
request_gpus = 2
+GPUJobLength = "medium"
gpus_minimum_memory = 10GB
gpus_minimum_capability = 7.0

request_cpus = 12
request_memory = 64GB
request_disk = 100GB

# Run MedImage-FLEX
queue