# medflamingo.sub

universe = container
container_image = docker://jamesmml/medimage-flex-medflamingo:v1

executable = ./execute-testbench.sh

log = medflamingo_$(Cluster)_$(Process).log
error = medflamingo_$(Cluster)_$(Process).err
output = medflamingo_$(Cluster)_$(Process).out

# File transfers
should_transfer_files = YES
transfer_input_files = ./testbench, ./medflamingo/config.json, osdf:///chtc/staging/m/milgram2/datasets.zip
transfer_output_files = embeddings, results
when_to_transfer_output = ON_EXIT

# Request hardware
# request_gpus = 3
# +GPUJobLength = "medium"
# gpus_minimum_memory = 10GB

request_cpus = 5
request_memory = 64GB
request_disk = 100GB

# Run MedImage-FLEX
queue